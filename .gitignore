# Gradle
build/
.gradle/
.kotlin/
/captures
.externalNativeBuild
.cxx

# Local machine config -- contains your SDK path (and later, secrets like the
# OAuth client id) and must never be shared/committed.
local.properties

# Room schema exports -- regenerated by KSP on every build, see app/build.gradle.kts.
app/schemas/

# Signing (if/when a release keystore is set up)
*.jks
*.keystore
keystore.properties

# Android Studio / IntelliJ
.idea/
*.iml

# OS cruft
.DS_Store
Thumbs.db

# Ad-hoc local test images -- not part of the app or its real tests (those
# live in app/src/androidTest/assets/labels, which IS committed).
/sample_data/
